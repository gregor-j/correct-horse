{
    "name": "gregorj/correct-horse",
    "description": "A random passphrase generator inspired by Randall Munroes XKCD #936",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "GregorJ\\CorrectHorse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\GregorJ\\CorrectHorse\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0.2"
    }
}
